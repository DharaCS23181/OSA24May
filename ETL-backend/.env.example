# ArithFlow — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Production domain: https://etl.onestopanalytics.com

# ── App ──────────────────────────────────────────────────────
APP_NAME=ArithFlow
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
WORKERS=2

# ── Database ─────────────────────────────────────────────────
# Use postgresql+asyncpg:// for PostgreSQL (recommended for production).
# SQLite is supported for local development only.
DATABASE_URL=postgresql+asyncpg://arithflow:CHANGE_ME@localhost:5432/arithflow

# Connection pool — tune based on your server's available connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ── Security ─────────────────────────────────────────────────
# AES-256 key for encrypting saved credentials in the vault.
# Generate a fresh one: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_SECRET_KEY=your_generated_key_here

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated. Add your domain here for production.
CORS_ORIGINS=https://etl.onestopanalytics.com,http://etl.onestopanalytics.com,http://localhost:3000,http://localhost:8000

# ── Resource limits ──────────────────────────────────────────
# These prevent the server from running out of memory on a VPS.
MEMORY_LIMIT_MB=512
MAX_CONCURRENT_JOBS=2
CHUNK_SIZE_ROWS=50000

# ── S3 / R2 compatible storage (optional) ────────────────────
# Leave blank to disable cloud storage features.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=

# ── AI Copilot (optional) ────────────────────────────────────
# Get a free Groq key at https://console.groq.com
GROQ_API_KEY=
